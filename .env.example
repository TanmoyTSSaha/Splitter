# Copy to `.env` in project root for local development.
# CI / release builds should pass --dart-define instead.

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_PASSWORD=
SUPABASE_DB_URL=
GEMINI_API_KEY=
GOOGLE_WEB_CLIENT_ID=
# Client publishable key for donate + Pro checkout UI.
RAZORPAY_KEY_ID=
# Sentry DSN from https://split0.sentry.io/settings/projects/splitr/keys/
SENTRY_DSN=
# Optional override: development | staging | production | ci
SENTRY_ENVIRONMENT=
# Server-only (Supabase Edge Function secrets): RAZORPAY_KEY_SECRET,
# RAZORPAY_WEBHOOK_SECRET, RAZORPAY_PLAN_MONTHLY_ID, RAZORPAY_PLAN_YEARLY_ID
